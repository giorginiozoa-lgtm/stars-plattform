{
  "name": "stars-platform",
  "version": "1.0.0",
  "private": true,
  "description": "stars Community-Plattform – MVP-Prototyp (Bachelorarbeit)",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "node server/src/seed.js",
    "dev": "concurrently -n \"API,WEB\" -c \"blue,magenta\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:demo": "npm --prefix client run build:demo",
    "start": "node server/src/index.js",
    "start:prod": "node server/src/start.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
